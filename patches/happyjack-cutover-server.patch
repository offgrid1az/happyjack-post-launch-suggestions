+def legacy_redirects():
+    """The 301 map for old URLs, from hosting/redirects.json (same source as _redirects)."""
+    spec = json.loads((ROOT / "hosting" / "redirects.json").read_text(encoding="utf-8"))
+    rules = list(spec["rules"]) + ([spec["safety_net"]] if spec.get("safety_net") else [])
+    return [(r["source"], r["target"], int(r["status"])) for r in rules]
+
+
+LEGACY = legacy_redirects()
+
+
+# Held deliberately at 404, against the map in hosting/redirects.json.
+# AUDIT-DECISIONS-2026-11-17.md F5: "[No] generic homepage 301 was invented; any
+# launch redirect should follow the approved legacy map." The sold listing was
+# deleted 2026-10-29 (DESIGN_FEEDBACK.md, PAGE SET); the pre-host artifact still
+# carries a rule for it, so the server refuses that one rule until the artifact
+# and the decision are reconciled in one commit.
+HELD_LEGACY = {"/moqui-drive"}
+
+
+def legacy_target(path):
+    """First-match-wins, with a trailing * meaning 'everything under this prefix'."""
+    if path.rstrip("/") in HELD_LEGACY:
+        return None
+    for source, target, status in LEGACY:
+        if source.endswith("*"):
+            if path.startswith(source[:-1]):
+                return target, status
+        elif path == source or path == source + "/":
+            return target, status
+    return None
+
